{
  // Must match the existing Worker name, or you'll get a second URL.
  "name": "atelier-interior",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    // Unmatched paths fall back to index.html so react-router deep links work.
    "not_found_handling": "single-page-application",
    // Everything else is served straight from the edge; only /api/* wakes the Worker.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atelier-interiors",
      "database_id": "12e2e29a-d9ba-45f8-bcb5-68a403dfde17"
    }
  ],

  "observability": {
    "enabled": true
  }
}
